# Copy to .env in this folder (or export in your shell). Used by generate_level_audio.py.

GOOGLE_API_KEY=

# Optional: kids | adults (CLI --flavor overrides this). kids → playful style prompt,
# youthful voice defaults, writes under levels/{level}/kids/ (adults → .../adults/),
# prefers {flavor}/questions.json when present.
# GEMINI_TTS_FLAVOR=kids

# Adults voice pools (used when flavor=adults). Unset → Puck / Leda.
GEMINI_TTS_MALE_VOICES=Puck,Kore,Charon
GEMINI_TTS_FEMALE_VOICES=Leda,Kore

# Kids voice pools (used when flavor=kids). Unset → built-in youthful defaults
# (Puck,Fenrir,Sadachbia,Achird / Leda,Laomedeia,Aoede,Zephyr,Autonoe).
# Does not inherit GEMINI_TTS_MALE_VOICES / FEMALE_VOICES.
# GEMINI_TTS_KIDS_MALE_VOICES=Puck,Fenrir,Sadachbia,Achird
# GEMINI_TTS_KIDS_FEMALE_VOICES=Leda,Laomedeia,Aoede,Zephyr,Autonoe

# Optional: override the spoken style prompt. Must include the literal {text} placeholder.
# Adults default: Say in a clear, friendly tone for a young learner: "{text}"
# Kids default:   Say in a young child's high-pitched, playful, clear voice: "{text}"
# GEMINI_TTS_STYLE_PROMPT=Say in a young child's high-pitched, playful, clear voice: "{text}"

# Optional: cycle single-speaker (non–gender-routed) clips through male+female lists.
# GEMINI_TTS_VOICE_ROTATE=1
