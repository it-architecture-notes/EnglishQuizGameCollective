{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (state in project)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "args": [
        "--dart-define=QUIZ_STATE_PATH=${workspaceFolder}/app/assets/data/state"
      ]
    },
    {
      "name": "Flutter",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/app"
    },
    {
      "name": "Flutter (web-server, persistent progress)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "deviceId": "web-server",
      "args": ["--web-port=8080"]
    },
    {
      "name": "Flutter (kids flavor)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "args": ["--dart-define=FLAVOR=kids"]
    }
  ]
}
